# Discord Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here

# Database Configuration (PostgreSQL)
# Format: postgresql://username:password@host:port/database_name?schema=public
DATABASE_URL=postgresql://postgres:postgres_password_here@postgres:5472/warera_egypt_bot?schema=public

# WarEra API Configuration
WARERA_API_KEY=your_warera_api_key_here
WARERA_API_BASE_URL=https://api2.warera.io/trpc/

# Application Settings
NODE_ENV=production
LOG_LEVEL=info
