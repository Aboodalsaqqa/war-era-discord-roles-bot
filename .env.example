# ============================================
# WarEra Egypt Discord Bot — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

# -------------------------------------------
# REQUIRED — Application will NOT start without these
# -------------------------------------------

# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Discord application client ID (for slash command registration)
DISCORD_CLIENT_ID=your_discord_application_client_id_here

# PostgreSQL connection string (used by Prisma)
# Format: postgresql://user:password@host:port/database?schema=public
# For Supabase: use the DIRECT connection (port 5432), not the pooler (port 6543)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/warera_egypt_bot?schema=public

# WarEra API key for authentication
WARERA_API_KEY=your_warera_api_key_here

# -------------------------------------------
# OPTIONAL — Have sensible defaults
# -------------------------------------------

# WarEra API base URL (default: https://api2.warera.io/trpc/)
# WARERA_API_BASE_URL=https://api2.warera.io/trpc/

# Node environment (default: undefined; set to "production" for JSON logs)
# NODE_ENV=production

# Log level: trace | debug | info | warn | error | fatal | silent (default: info)
# LOG_LEVEL=info
